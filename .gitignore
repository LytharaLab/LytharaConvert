# ── 依赖 ────────────────────────────────────────────────────────
node_modules/

# ── 构建产物（全部可由 npm run build / dist 重新生成）──────────────
dist/
target/
portable/

# ── 引擎二进制 ──────────────────────────────────────────────────
# ffmpeg.exe + ffprobe.exe 约 140 MB，不进版本库；克隆后跑
#   pwsh scripts/fetch-ffmpeg.ps1
# 补齐，或改用设置里的自定义路径 / LYTHARA_FFMPEG 环境变量。
server/binaries/

# ── 运行时数据（服务在 exe 旁边自动生成）────────────────────────
appdata/
uploads/

# ── 日志与临时文件 ──────────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
*.rej
*.swp
*~

# ── 本机环境适配，不是项目配置 ──────────────────────────────────
# .npmrc  证书 / 镜像等本机网络适配（见文件头注释）
# AGENTS.md  本机 AI 助手的工作笔记
.npmrc
AGENTS.md

# ── 编辑器与系统 ────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
